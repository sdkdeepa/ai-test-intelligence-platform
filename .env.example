# Backend (see backend/app/config.py for defaults)
APP_NAME="AI Test Intelligence Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Provider selection (see backend/app/providers/config.py for defaults).
# Leave PROVIDER_DEFAULT_PROVIDER=mock (or PROVIDER_ANTHROPIC_API_KEY unset)
# to keep the deterministic MockProvider active — this is required for
# CI/tests and is the safe default for local development too.
PROVIDER_DEFAULT_PROVIDER=mock
# PROVIDER_RISK_PROVIDER=
# PROVIDER_TEST_INTELLIGENCE_PROVIDER=
# PROVIDER_FAILURE_INTELLIGENCE_PROVIDER=

# Anthropic Claude provider. NEVER commit a real key — this file is a
# template; your actual .env is gitignored. Setting a key here does nothing
# unless PROVIDER_DEFAULT_PROVIDER (or a per-engine override above) is also
# set to "anthropic".
# PROVIDER_ANTHROPIC_API_KEY=
PROVIDER_ANTHROPIC_MODEL=claude-sonnet-5
PROVIDER_ANTHROPIC_MAX_TOKENS=1024
PROVIDER_ANTHROPIC_TIMEOUT=60
PROVIDER_ANTHROPIC_MAX_RETRIES=2

# Database (see backend/app/persistence/config.py for defaults).
# POSTGRES_* configure docker-compose's postgres service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_test_intelligence
POSTGRES_PORT=5432
# DATABASE_URL is left unset here on purpose: docker-compose.yml supplies its
# own default (hostname "postgres") for the backend container. Only set this
# in your actual .env if running the backend outside docker-compose (e.g.
# `postgresql+psycopg://postgres:postgres@localhost:5432/ai_test_intelligence`).
# DATABASE_URL=
# DATABASE_ECHO=false
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# LangSmith (see backend/app/observability/config.py for defaults). Strictly
# optional — LANGSMITH_ENABLED=false (the default) means every LangSmith call
# is a no-op, no API key required. This is required for CI/tests and is the
# safe default for local development too; flip it on only when you actually
# want traces/datasets showing up in a LangSmith project.
LANGSMITH_ENABLED=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-test-intelligence-platform
# LANGSMITH_ENDPOINT=

# GitHub PR integration (see backend/app/integrations/github/config.py for
# defaults). Both left unset here on purpose:
# - GITHUB_WEBHOOK_SECRET unset means the webhook endpoint fails closed
#   (401 on every request) rather than accepting unsigned deliveries — set
#   this to the same secret configured on the GitHub webhook itself.
# - GITHUB_API_TOKEN unset means webhooks are still received/verified and
#   analysis still runs, but nothing publishes back to GitHub (a
#   NullGitHubClient no-ops the outbound calls). A fine-grained PAT with
#   pull-request read + statuses/issues write scopes is sufficient — no
#   GitHub App installation required.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_API_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_PLATFORM_BASE_URL is used to build "view full analysis" links in
# PR comments — point it at wherever the frontend dashboard is actually
# reachable from a reviewer's browser (not localhost, outside local dev).
GITHUB_PLATFORM_BASE_URL=http://localhost:5173

# Governance policy (see backend/app/governance/config.py for defaults).
# GOVERNANCE_ENABLED=false is a global kill-switch — every risk result
# auto-approves, same as pre-governance behavior — useful for local dev.
GOVERNANCE_ENABLED=true
GOVERNANCE_RISK_SCORE_THRESHOLD=0.7
GOVERNANCE_CONFIDENCE_THRESHOLD=0.5
GOVERNANCE_MIN_EVIDENCE_COUNT=1
GOVERNANCE_REQUIRE_REVIEW_ON_BLOCK=true
GOVERNANCE_REQUIRE_REVIEW_ON_CAUTION=false
